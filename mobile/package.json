{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.2",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start --lan --go",
    "start:dev-client": "expo start --dev-client --lan --clear",
    "start:clear": "expo start --lan --clear",
    "start:offline": "expo start --offline",
    "start:tunnel": "expo start --tunnel",
    "start:online": "expo start --lan",
    "android": "expo start --lan --android",
    "ios": "expo start --lan --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@supabase/supabase-js": "^2.78.0",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.20",
    "expo-asset": "~57.0.16",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-font": "~57.0.3",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-mobile-ads": "15.8.3",
    "react-native-purchases": "^10.4.4",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.4",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  }
}
