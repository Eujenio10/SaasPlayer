# Stesse credenziali Supabase del progetto web (.env.local)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# URL del backend Next.js raggiungibile dal telefono
# Emulatore Android: http://10.0.2.2:3000
# Simulatore iOS: http://localhost:3000
# Dispositivo fisico (Expo Go): http://IP_DEL_PC:3000  (es. http://192.168.1.42:3000)
EXPO_PUBLIC_API_URL=http://192.168.1.42:3000

# Sul server Next.js (.env.local) imposta anche (consigliato in produzione):
# PITCHBRAIN_PUBLIC_ORG_ID=<uuid-organizzazione-demo-per-guest>
# Se assente, il backend usa come fallback la prima org con calendario persistito.

# Solo sviluppo UI: usa dati mock per il Report Pre-Partita (1 = attivo)
# EXPO_PUBLIC_USE_PREMATCH_MOCK=1

# In-App Purchase (App Store / Play Store via RevenueCat)
# EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=appl_xxx
# EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=goog_xxx
# EXPO_PUBLIC_RC_ENTITLEMENT_PRO=pro
# EXPO_PUBLIC_RC_OFFERING_ID=default
# EXPO_PUBLIC_RC_PACKAGE_PRO_MONTHLY=$rc_monthly
# EXPO_PUBLIC_IAP_FORCE_MOCK=1
