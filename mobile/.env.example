# Stesse credenziali Supabase del progetto web (.env.local)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Deep link auth — dipende dal BUILD EAS sul telefono, non da Metro locale/expo.dev
# Scheme nativo (deve coincidere con app.json + build installato):
# EXPO_PUBLIC_AUTH_CALLBACK_SCHEME=pitchbrain
# Se il dev build vecchio usa ancora tactical-hub, finché non rifai EAS build:
# EXPO_PUBLIC_AUTH_CALLBACK_SCHEME=tactical-hub
# Conferma registrazione via web (consigliato su iOS finché pitchbrain:// non è stabile):
# EXPO_PUBLIC_AUTH_WEB_SIGNUP_CONFIRM=1
# Reset password via pitchbrain:// (default: web /set-password):
# EXPO_PUBLIC_AUTH_MOBILE_PASSWORD_RESET=1

# URL del backend Next.js (produzione: https://saas-player.vercel.app)
EXPO_PUBLIC_API_URL=https://saas-player.vercel.app

# In-App Purchase (RevenueCat) — obbligatorie per build production iOS/Android
# iOS (App Store):
# EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=appl_xxx
# Android (Google Play) — stesso progetto RevenueCat, app Play separata:
# EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=goog_xxx
# Product ID Play Console: pitchbrain_pro_monthly (allineato ad Apple)
# EXPO_PUBLIC_RC_ENTITLEMENT_PRO=PitchBrain Pro
# Deve coincidere ESATTAMENTE con l'entitlement in RevenueCat.
# EXPO_PUBLIC_RC_OFFERING_ID=default
# EXPO_PUBLIC_RC_PACKAGE_PRO_MONTHLY=$rc_monthly
# EXPO_PUBLIC_IAP_FORCE_MOCK=0

# AdMob Rewarded — obbligatorie per production (niente sample unit Google)
# EXPO_PUBLIC_ADMOB_REWARDED_UNIT_IOS=ca-app-pub-xxxx/yyyy
# EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ANDROID=ca-app-pub-xxxx/yyyy
# EXPO_PUBLIC_ADS_FORCE_MOCK=0
# In dev, con FORCE_MOCK=0 usa TestIds Google (fill sicuro). Per forzare le unit reali:
# EXPO_PUBLIC_ADMOB_USE_PRODUCTION_UNITS=1

# Solo sviluppo UI
# EXPO_PUBLIC_USE_PREMATCH_MOCK=1
